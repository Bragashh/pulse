<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pulse — DevOps Monitoring Platform</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: #0f172a;
      color: #f1f5f9;
      min-height: 100vh;
      line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }

    .container { max-width: 1400px; margin: 0 auto; padding: 0 24px; }

    header {
      background: #020617;
      border-bottom: 1px solid #1e293b;
      padding: 18px 0;
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(8px);
    }
    header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand .logo { font-size: 26px; }
    .brand h1 { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
    .brand .tag {
      font-size: 12px; color: #94a3b8;
      padding: 3px 9px; background: #1e293b;
      border-radius: 4px; letter-spacing: 0.02em;
    }
    .header-right { display: flex; gap: 12px; align-items: center; }
    .header-right .refresh { font-size: 12px; color: #64748b; }
    .admin-link {
      font-size: 12px;
      color: #94a3b8;
      padding: 6px 12px;
      border: 1px solid #334155;
      border-radius: 6px;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .admin-link:hover { border-color: #3b82f6; color: #60a5fa; }

    button, .button {
      background: #3b82f6;
      color: white;
      border: none;
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.05s ease;
      letter-spacing: 0.02em;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    button:hover:not(:disabled), .button:hover { background: #2563eb; }
    button:active:not(:disabled), .button:active { transform: translateY(1px); }
    button:disabled { background: #334155; color: #64748b; cursor: not-allowed; }
    button.secondary, .button.secondary {
      background: transparent;
      border: 1px solid #334155;
      color: #f1f5f9;
    }
    button.secondary:hover:not(:disabled), .button.secondary:hover {
      border-color: #3b82f6;
      color: #60a5fa;
      background: rgba(59, 130, 246, 0.05);
    }
    button.stop { background: #ef4444; }
    button.stop:hover:not(:disabled) { background: #dc2626; }

    h2 {
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #94a3b8;
      margin: 40px 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 1px solid #1e293b;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    h2 .h2-aux {
      font-size: 12px;
      font-weight: 500;
      text-transform: none;
      letter-spacing: 0;
    }
    h2 .h2-aux a { color: #60a5fa; }
    h2 .h2-aux a:hover { text-decoration: underline; }

    .hero {
      background: linear-gradient(135deg, #1e293b 0%, #1e3a8a 100%);
      border-radius: 16px;
      padding: 40px;
      margin: 32px 0;
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 40px;
      align-items: center;
    }
    .hero-score {
      font-size: 88px;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.04em;
    }
    .hero-score.healthy { color: #10b981; }
    .hero-score.degraded { color: #f59e0b; }
    .hero-score.critical { color: #ef4444; }
    .hero-label { font-size: 13px; color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
    .hero-text { font-size: 22px; font-weight: 600; }
    .hero-sub { font-size: 14px; color: #94a3b8; margin-top: 8px; }
    .hero-actions { display: flex; flex-direction: column; gap: 8px; min-width: 200px; }

    .grid { display: grid; gap: 16px; }
    .grid-3 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
    .grid-2 { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); }

    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 20px;
    }
    .card-label {
      font-size: 12px;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }
    .card-value {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .card-value.medium { font-size: 24px; }
    .card-sub { font-size: 12px; color: #94a3b8; margin-top: 6px; }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 11px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .pill.up, .pill.healthy { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .pill.degraded { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .pill.down, .pill.critical { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

    .uptime-list { display: grid; gap: 8px; }
    .uptime-row {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: border-color 0.15s ease;
    }
    .uptime-row:hover { border-color: #475569; }
    .uptime-name { font-size: 15px; font-weight: 600; }
    .uptime-url { font-size: 12px; color: #64748b; font-family: 'JetBrains Mono', 'Consolas', monospace; margin-top: 2px; }
    .uptime-latency { font-size: 12px; color: #94a3b8; font-family: monospace; }

    /* --- Unified demo controller --- */
    .demo-controller {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 28px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 800px) {
      .demo-controller { grid-template-columns: 1fr; }
    }
    .demo-controller .left h3 { font-size: 18px; font-weight: 600; margin-bottom: 8px; }
    .demo-controller .left p {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 16px;
    }
    .demo-controller .controls { display: flex; flex-direction: column; gap: 14px; }
    .control-row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
    .control-row > label {
      display: flex; flex-direction: column; gap: 4px;
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8;
      flex: 1; min-width: 130px;
    }
    .control-row select, .control-row input {
      background: #0f172a;
      border: 1px solid #334155;
      color: #f1f5f9;
      padding: 9px 11px;
      border-radius: 4px;
      font-size: 14px;
      font-family: 'JetBrains Mono', 'Consolas', monospace;
    }
    .control-row select:disabled, .control-row input:disabled { opacity: 0.5; cursor: not-allowed; }
    .control-row select:focus, .control-row input:focus { outline: none; border-color: #3b82f6; }

    .demo-buttons { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .demo-status {
      font-size: 13px; color: #94a3b8; font-family: monospace;
      margin-top: 8px;
    }
    .demo-status.running { color: #f59e0b; }
    .demo-status.error { color: #ef4444; }

    .demo-cta {
      background: linear-gradient(135deg, #1e3a8a 0%, #1e293b 100%);
      border: 1px solid #3b82f6;
      border-radius: 10px;
      padding: 22px;
      display: flex; flex-direction: column; gap: 14px;
      justify-content: center;
    }
    .demo-cta-title { font-size: 14px; color: #cbd5e1; }
    .demo-cta strong { color: #60a5fa; }

    footer {
      text-align: center;
      color: #64748b;
      font-size: 12px;
      padding: 32px 0;
      margin-top: 48px;
      border-top: 1px solid #1e293b;
    }
    footer a { color: #60a5fa; }
    footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <div class="brand">
        <span class="logo">⚡</span>
        <h1>Pulse</h1>
        <span class="tag">DevOps Monitoring</span>
      </div>
      <div class="header-right">
        <span class="refresh" id="last-refresh">Loading…</span>
        <a class="admin-link" href="https://admin.pulse-hq.dev" target="_blank">🔒 Admin</a>
      </div>
    </div>
  </header>

  <div class="container">
    <!-- Hero -->
    <div class="hero">
      <div>
        <div class="hero-label">Health Score</div>
        <div class="hero-score" id="hero-score">—</div>
      </div>
      <div>
        <div class="hero-text" id="hero-text">Loading…</div>
        <div class="hero-sub">Live monitoring across services, infrastructure, and DORA metrics.</div>
      </div>
    </div>

    <!-- Host Health -->
    <h2>Host Health</h2>
    <div class="grid grid-3">
      <div class="card">
        <div class="card-label">CPU</div>
        <div class="card-value" id="cpu">—%</div>
        <div class="card-sub" id="cpu-status">checking…</div>
      </div>
      <div class="card">
        <div class="card-label">Memory</div>
        <div class="card-value" id="mem">—%</div>
        <div class="card-sub" id="mem-detail">—</div>
      </div>
      <div class="card">
        <div class="card-label">Disk</div>
        <div class="card-value" id="disk">—%</div>
        <div class="card-sub">root filesystem</div>
      </div>
    </div>

    <!-- Uptime monitoring -->
    <h2>Service Uptime</h2>
    <div class="uptime-list" id="uptime-list">
      <div class="card">Loading…</div>
    </div>

    <!-- DORA metrics -->
    <h2>DORA Metrics</h2>
    <div class="grid grid-2">
      <div class="card">
        <div class="card-label">Deployment Frequency</div>
        <div class="card-value medium" id="dora-deploys">—</div>
        <div class="card-sub" id="dora-deploys-sub">commits to main, last 7 days</div>
      </div>
      <div class="card">
        <div class="card-label">Change Failure Rate</div>
        <div class="card-value medium" id="dora-failures">—</div>
        <div class="card-sub" id="dora-failures-sub">CI runs analyzed</div>
      </div>
    </div>

    <!-- Demo Controls -->
    <h2>
      Try It Live
      <span class="h2-aux">→ <a href="https://{{ grafana_hostname }}/d/pulse-overview?kiosk" target="_blank">Open the metrics dashboard</a> in another tab to watch the spike</span>
    </h2>
    <div class="demo-controller">
      <div class="left">
        <h3>Generate Load</h3>
        <p>
          Run a live load test against the Pulse backend. Traffic, errors, and slow requests are
          simulated together to make every Grafana panel react in real time. Rate-limited to 1 test
          per minute per visitor.
        </p>
        <div class="controls">
          <div class="control-row">
            <label>Stress level
              <select id="level">
                <option value="1">1 — Low (gentle warmup)</option>
                <option value="2">2 — Medium-low</option>
                <option value="3" selected>3 — Medium</option>
                <option value="4">4 — High</option>
                <option value="5">5 — Max</option>
              </select>
            </label>
            <label>Duration (sec, 30–180)
              <input type="number" id="duration" value="60" min="30" max="180" />
            </label>
          </div>
          <div class="demo-buttons">
            <button id="start-btn" onclick="startDemo()">▶ Start Test</button>
            <button class="stop" id="stop-btn" onclick="stopDemo()" disabled>■ Stop</button>
          </div>
          <div class="demo-status" id="status"></div>
        </div>
      </div>
      <div class="demo-cta">
        <div class="demo-cta-title">Watch it happen in real time</div>
        <p style="font-size:13px;color:#cbd5e1;">
          The <strong>live metrics dashboard</strong> shows request rate, error rate, p95 latency,
          and host resources updating every 5 seconds. Click Start, switch tabs, and watch the
          panels react.
        </p>
        <a class="button" href="https://{{ grafana_hostname }}/d/pulse-overview?kiosk" target="_blank">📊 Open Live Metrics</a>
      </div>
    </div>

    <footer>
      Pulse v1.5.1 &middot; built by <a href="https://github.com/Bragashh" target="_blank">@Bragashh</a> &middot;
      <a href="https://github.com/Bragashh/pulse" target="_blank">source on GitHub</a>
    </footer>
  </div>

  <script>
    let currentDemoId = null;
    let unlockTimeout = null;

    function updateRefresh() {
      document.getElementById('last-refresh').textContent = 'updated ' + new Date().toLocaleTimeString();
    }

    async function refreshHealth() {
      try {
        const [score, metrics] = await Promise.all([
          fetch('/api/score').then(r => r.json()),
          fetch('/api/metrics').then(r => r.json()),
        ]);

        const scoreEl = document.getElementById('hero-score');
        scoreEl.textContent = score.score;
        scoreEl.className = 'hero-score ' + score.status;

        const status = score.status;
        const textEl = document.getElementById('hero-text');
        textEl.innerHTML = status === 'healthy'
          ? 'All systems operational <span class="pill healthy">healthy</span>'
          : status === 'degraded'
          ? 'Some services degraded <span class="pill degraded">degraded</span>'
          : 'Service issues detected <span class="pill critical">critical</span>';

        document.getElementById('cpu').textContent = metrics.cpu.percent.toFixed(0) + '%';
        document.getElementById('cpu-status').textContent = metrics.cpu.percent > 80 ? 'high' : metrics.cpu.percent > 60 ? 'elevated' : 'nominal';
        document.getElementById('mem').textContent = metrics.memory.percent.toFixed(0) + '%';
        const memGb = (metrics.memory.used / (1024 ** 3)).toFixed(1);
        const memTotalGb = (metrics.memory.total / (1024 ** 3)).toFixed(1);
        document.getElementById('mem-detail').textContent = `${memGb} / ${memTotalGb} GB`;
        document.getElementById('disk').textContent = metrics.disk.percent.toFixed(0) + '%';
        updateRefresh();
      } catch (err) {
        console.error('refreshHealth failed:', err);
      }
    }

    async function refreshUptime() {
      try {
        const data = await fetch('/api/uptime').then(r => r.json());
        const list = document.getElementById('uptime-list');
        list.innerHTML = data.services.map(s => {
          const status = s.status || 'unknown';
          const latency = s.latency_ms !== undefined ? `${s.latency_ms} ms` : '';
          return `
            <div class="uptime-row">
              <div>
                <div class="uptime-name">${s.name}</div>
                <div class="uptime-url">${s.url}</div>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
                <span class="pill ${status}">${status}</span>
                <span class="uptime-latency">${latency}</span>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.error('refreshUptime failed:', err);
      }
    }

    async function refreshDora() {
      try {
        const data = await fetch('/api/dora').then(r => r.json());
        const deploys = data.deployment_frequency;
        document.getElementById('dora-deploys').textContent = deploys.commits_last_7_days;
        document.getElementById('dora-deploys-sub').textContent = `${deploys.per_day}/day average, last 7 days`;

        const fails = data.change_failure_rate;
        document.getElementById('dora-failures').textContent = fails.failure_rate_percent + '%';
        document.getElementById('dora-failures-sub').textContent = `${fails.failed_runs} of ${fails.total_runs} CI runs failed`;
      } catch (err) {
        console.error('refreshDora failed:', err);
      }
    }

    function setControlsEnabled(enabled) {
      document.getElementById('level').disabled = !enabled;
      document.getElementById('duration').disabled = !enabled;
      document.getElementById('start-btn').disabled = !enabled;
      document.getElementById('stop-btn').disabled = enabled;  // inverted
    }

    function showStatus(text, cls) {
      const el = document.getElementById('status');
      el.textContent = text;
      el.className = 'demo-status ' + (cls || '');
    }

    async function startDemo() {
      const level = Number(document.getElementById('level').value);
      const duration = Number(document.getElementById('duration').value);

      try {
        const resp = await fetch('/demo/full-spectrum', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ level, duration_seconds: duration }),
        });
        const data = await resp.json();

        if (!resp.ok || !data.started) {
          showStatus(data.error || 'failed to start', 'error');
          setTimeout(() => showStatus(''), 5000);
          return;
        }

        currentDemoId = data.demo_id;
        setControlsEnabled(false);
        const total = data.profile.rps * duration;
        showStatus(`Test running — level ${level}, ~${total} requests over ${duration}s. Watch the dashboard!`, 'running');

        // Auto-unlock when test finishes
        unlockTimeout = setTimeout(() => unlockControls(true), duration * 1000 + 1000);
      } catch (err) {
        showStatus('network error', 'error');
      }
    }

    async function stopDemo() {
      if (!currentDemoId) return;
      try {
        await fetch('/demo/stop/' + currentDemoId, { method: 'POST' });
      } catch (err) {
        console.error('stop failed:', err);
      }
      unlockControls(false);
    }

    function unlockControls(finishedNaturally) {
      if (unlockTimeout) {
        clearTimeout(unlockTimeout);
        unlockTimeout = null;
      }
      currentDemoId = null;
      setControlsEnabled(true);
      showStatus(finishedNaturally ? 'Test complete.' : 'Test stopped.', '');
      setTimeout(() => showStatus(''), 5000);
    }

    refreshHealth();
    refreshUptime();
    refreshDora();
    setInterval(refreshHealth, 10000);
    setInterval(refreshUptime, 15000);
    setInterval(refreshDora, 60000);
  </script>
</body>
</html>