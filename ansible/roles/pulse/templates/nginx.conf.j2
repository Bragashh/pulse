# nginx.conf — rendered by Ansible from roles/pulse/templates/nginx.conf.j2.
# DO NOT EDIT on the host directly; changes will be overwritten.
#
# Rendered for: {{ inventory_hostname }}
#   primary domain  : {{ primary_domain }}
#   grafana hostname: {{ grafana_hostname }}
#   prom hostname   : {{ prometheus_hostname }}

# Redirect HTTP to HTTPS, except ACME challenge
server {
    listen 80;
    server_name {{ primary_domain }}
                {% if primary_domain == 'pulse-hq.dev' %}www.pulse-hq.dev{% endif %}
                {{ grafana_hostname }}
                {{ prometheus_hostname }}
                {{ shortener_hostname }}
                {{ admin_hostname }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Pulse dashboard ---
server {
    listen 443 ssl;
    server_name {{ primary_domain }}{% if primary_domain == 'pulse-hq.dev' %} www.pulse-hq.dev{% endif %};

    ssl_certificate     /etc/letsencrypt/live/{{ primary_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain }}/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://pulse-backend:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /demo/ {
        proxy_pass http://pulse-backend:5000/demo/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# --- Grafana ---
server {
    listen 443 ssl;
    server_name {{ grafana_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ grafana_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ grafana_hostname }}/privkey.pem;

    location / {
        proxy_pass http://pulse-grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- Prometheus (basic auth) ---
server {
    listen 443 ssl;
    server_name {{ prometheus_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ prometheus_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ prometheus_hostname }}/privkey.pem;

    auth_basic           "Prometheus";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://pulse-prometheus:9090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# --- URL Shortener ---
server {
    listen 443 ssl;
    server_name {{ shortener_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ shortener_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ shortener_hostname }}/privkey.pem;

    location / {
        proxy_pass http://pulse-url-shortener:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Admin console ---
server {
    listen 443 ssl;
    server_name {{ admin_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ admin_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ admin_hostname }}/privkey.pem;

    auth_basic           "Admin";
    auth_basic_user_file /etc/nginx/.htpasswd;

    root /usr/share/nginx/html;
    index admin.html;

    location / {
        try_files /admin.html =404;
    }

    # Demo endpoints — admin surface, no rate limit / higher concurrency
    location /demo/ {
        proxy_pass http://pulse-backend:5000/demo/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Admin-Surface "1";
    }

    # Score and metrics for system health panels
    location ~ ^/(score|metrics|health|services|uptime)$ {
        proxy_pass http://pulse-backend:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Admin-Surface "1";
    }
}